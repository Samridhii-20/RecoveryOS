# ==================================================
# RecoveryOS — Git Ignore Rules
# ==================================================

# ----- Environment & Secrets -----
.env
*.env.local

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
venv/
.venv/
*.whl

# ----- Data & ML Artifacts (generated at runtime) -----
data/*
!data/evaluation_report.json
!data/recovery_model.joblib

# ----- Node / Frontend -----
node_modules/
dist/

# ----- OS Artifacts -----
.DS_Store
Thumbs.db

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~
