# ==================================================
# RecoveryOS — Backend Environment Configuration
# ==================================================
# Copy this file to .env and fill in your values.
# This file is safe to commit to version control.
# ==================================================

# ----- Server -----
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ----- Database (Neon PostgreSQL) -----
# Get your connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ----- CORS -----
# Comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS=http://localhost:3000

# ----- Razorpay Test Mode Credentials -----
# Get your test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here

# ----- Groq LLM (Recovery Reasoning Agent) -----
# Get your API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ----- Guardrail Policy Thresholds -----
HIGH_VALUE_THRESHOLD=50000.0
MAX_RECOVERY_ATTEMPTS=2
MAX_DISCOUNT_PCT=5.0
MAX_DISCOUNT_CAP=500.0
MIN_CONFIDENCE_THRESHOLD=0.60

# ----- Scoring Engine -----
DEFAULT_MARGIN_PCT=0.40

# ----- Data Seeding -----
SEED_EVENT_COUNT=1000
